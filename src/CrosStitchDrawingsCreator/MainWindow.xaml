<Window x:Class="CrosStitchDrawingsCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrosStitchDrawingsCreator"
        xmlns:vm="clr-namespace:CrosStitchDrawingsCreator.ViewModels"
        mc:Ignorable="d"
        Title="十字绣图纸制作工具" Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStyle="None" AllowsTransparency="True"
        Background="{StaticResource SurfaceBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <!-- ════════════════════════════════════ -->
                <!--  CUSTOM TITLE BAR                    -->
                <!-- ════════════════════════════════════ -->
                <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        CornerRadius="8,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text=" 🧵  十字绣图纸制作工具"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="16,0,0,0"/>

                        <!-- Window control buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                            <Button x:Name="MinimizeBtn" Content="─"
                                    Width="46" Height="32" FontSize="14"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Click="OnMinimizeClick"
                                    Style="{x:Null}"/>
                            <Button x:Name="MaximizeBtn" Content="□"
                                    Width="46" Height="32" FontSize="14"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Click="OnMaximizeClick"
                                    Style="{x:Null}"/>
                            <Button x:Name="CloseBtn" Content="✕"
                                    Width="46" Height="32" FontSize="14"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Click="OnCloseClick"
                                    Style="{x:Null}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ════════════════════════════════════ -->
                <!--  MAIN CONTENT: 3-COLUMN LAYOUT      -->
                <!-- ════════════════════════════════════ -->
                <Grid Grid.Row="1" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>

                    <!-- ─── LEFT PANEL: PARAMETERS ─── -->
                    <ScrollViewer Grid.Column="0"
                                  Background="{StaticResource CardBrush}"
                                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                                  Padding="16,12"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <!-- Image Import Section -->
                            <TextBlock Text="📷 导入图片" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>

                            <Border Style="{StaticResource CardGroupStyle}" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Thumbnail -->
                                    <Border x:Name="ImageDropZone" Height="140"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="6"
                                            AllowDrop="True"
                                            Drop="OnImageDrop"
                                            DragOver="OnImageDragOver"
                                            DragLeave="OnImageDragLeave">
                                        <Grid>
                                            <Image x:Name="ThumbnailImage" Source="{Binding ThumbnailImage}"
                                                   Stretch="Uniform" Margin="4"
                                                   Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}"/>
                                            <TextBlock Text="拖拽图片到此处&#x0a;或点击下方按钮选择"
                                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextAlignment="Center" LineHeight="20"
                                                       Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVisibility}}"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{Binding ImageInfoText}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,6,0,0"
                                               Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}"/>

                                    <Grid Margin="0,8,0,0" Grid.ColumnSpan="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="选择图片" Command="{Binding ImportImageCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" Height="34" FontSize="12"
                                                Margin="0,0,4,0"/>
                                        <Button Grid.Column="1" Content="粘贴" Command="{Binding PasteImageCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" Height="34" FontSize="12"
                                                Margin="4,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Parameter Section -->
                            <TextBlock Text="⚙️ 参数设定" Style="{StaticResource SectionLabelStyle}"/>

                            <Border Style="{StaticResource CardGroupStyle}" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Color Count -->
                                    <TextBlock Text="颜色数量" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Grid Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="2" Maximum="200" Value="{Binding ColorCount}"
                                                Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" Width="32" TextAlignment="Right">
                                            <TextBlock.Text>
                                                <Binding Path="ColorCount"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>

                                    <Separator Margin="0,4"/>

                                    <!-- Width -->
                                    <TextBlock Text="图纸宽度（针数）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Grid Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="10" Maximum="500" Value="{Binding PatternWidth}"
                                                Margin="0,0,8,0"
                                                IsSnapToTickEnabled="True" TickFrequency="10"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PatternWidth}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" Width="36" TextAlignment="Right"/>
                                    </Grid>

                                    <!-- Height -->
                                    <TextBlock Text="图纸高度（针数）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Grid Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="10" Maximum="500" Value="{Binding PatternHeight}"
                                                Margin="0,0,8,0"
                                                IsSnapToTickEnabled="True" TickFrequency="10"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PatternHeight}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" Width="36" TextAlignment="Right"/>
                                    </Grid>

                                    <CheckBox Content="锁定宽高比" IsChecked="{Binding AspectRatioLocked}" Margin="0,4,0,4"/>

                                    <Separator Margin="0,4"/>

                                    <!-- Grid Options -->
                                    <TextBlock Text="网格选项" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,8,0,4"/>
                                    <CheckBox Content="显示网格线" IsChecked="{Binding ShowGridLines}" Margin="0,2,0,2"/>
                                    <CheckBox Content="启用抖动" IsChecked="{Binding EnableDithering}" Margin="0,2,0,2"/>
                                </StackPanel>
                            </Border>

                            <!-- Generate Button -->
                            <Button Content="🔄  生成图纸" Command="{Binding GeneratePatternCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="44" FontSize="15"
                                    Margin="0,4,0,12"
                                    IsEnabled="{Binding HasImage}"/>

                            <!-- Export Section -->
                            <TextBlock Text="📥 导出" Style="{StaticResource SectionLabelStyle}"/>

                            <Border Style="{StaticResource CardGroupStyle}" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding ExportPath}" FontSize="11"
                                                 IsReadOnly="True" Height="30"/>
                                        <Button Grid.Column="1" Content="浏览" Command="{Binding SelectExportPathCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" Height="30"
                                                FontSize="11" Padding="8,0" Margin="4,0,0,0"/>
                                    </Grid>

                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="缩放倍数" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Slider Grid.Column="1" Minimum="1" Maximum="10" Value="{Binding ExportScale}"
                                                IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    </Grid>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4">
                                        <Run Text="{Binding ExportScale}"/><Run Text="×"/>
                                    </TextBlock>

                                    <CheckBox Content="包含网格线" IsChecked="{Binding ExportIncludeGridLines}" Margin="0,2,0,0"/>
                                    <CheckBox Content="包含颜色图例" IsChecked="{Binding ExportIncludeLegend}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Export Button -->
                            <Button Content="📤  导出 PNG" Command="{Binding ExportPngCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="40" FontSize="14"
                                    IsEnabled="{Binding HasPattern}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ─── CENTER: PREVIEW CANVAS ─── -->
                    <Border Grid.Column="1"
                            Background="{StaticResource CardBrush}"
                            Margin="0">
                        <Grid>
                            <!-- Empty state -->
                            <TextBlock Text="导入图片并点击「生成图纸」&#x0a;预览将显示在此处"
                                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" LineHeight="24"
                                       Visibility="{Binding HasPattern, Converter={StaticResource InverseBoolToVisibility}}"/>

                            <!-- Loading indicator -->
                            <Border x:Name="LoadingOverlay"
                                    Background="#80FFFFFF"
                                    Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="正在生成图纸..." FontSize="16"
                                               Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="正在进行颜色量化..." FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Preview Image -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <Image Source="{Binding PatternPreview}"
                                       Stretch="None"
                                       Margin="16"
                                       MouseWheel="OnPreviewMouseWheel"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ─── RIGHT PANEL: COLOR LEGEND ─── -->
                    <Border Grid.Column="2"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                            Padding="12">
                        <Grid>
                            <!-- Empty state -->
                            <TextBlock Text="🎨 颜色图例&#x0a;&#x0a;生成图纸后&#x0a;将显示颜色列表"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" LineHeight="18"
                                       Visibility="{Binding HasPattern, Converter={StaticResource InverseBoolToVisibility}}"/>

                            <StackPanel Visibility="{Binding HasPattern, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="🎨 颜色图例" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,4"/>
                                <Separator Margin="0,2,0,8"/>

                                <ItemsControl ItemsSource="{Binding PaletteEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,2" Padding="6,4" CornerRadius="4"
                                                    Background="{StaticResource SurfaceBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Color swatch -->
                                                    <Border Grid.Column="0" Width="20" Height="20"
                                                            CornerRadius="4"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding ., Converter={StaticResource PaletteEntryToColor}}"/>
                                                        </Border.Background>
                                                    </Border>

                                                    <!-- Label -->
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}">
                                                            <Run Text="DMC "/><Run Text="{Binding DmcCode}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Hex}" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </StackPanel>

                                                    <!-- Stitch count -->
                                                    <TextBlock Grid.Column="2" Text="{Binding StitchCount, StringFormat={}{0} 针}"
                                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ════════════════════════════════════ -->
                <!--  STATUS BAR                          -->
                <!-- ════════════════════════════════════ -->
                <Border Grid.Row="2"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,8,8"
                        Padding="16,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔄" FontSize="12" VerticalAlignment="Center"
                                   Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center">
                            <Run Text="{Binding PatternWidth}"/><Run Text="×"/><Run Text="{Binding PatternHeight}"/>
                            <Run Text="  |  "/>
                            <Run Text="{Binding ColorCount, StringFormat={}{0} 色}" />
                            <!-- Add current palette info -->
                            <Run Text="  |  "/>
                            <Run Text="{Binding PaletteCount, StringFormat={}{0} 颜色}"/>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
